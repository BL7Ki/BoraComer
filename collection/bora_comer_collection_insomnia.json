{
	"info": {
		"_postman_id": "bora-comer-collection",
		"name": "Projeto-Bora-comer",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"description": "Coleção de testes para o projeto Bora Comer, incluindo login, usuários, tipos de usuários, restaurantes e itens de menu."
	},
	"item": [
		{
			"name": "auth",
			"item": [
				{
					"name": "login",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"login\": \"admin\",\n  \"password\": \"senhaAdmin123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/login",
							"host": ["{{baseUrl}}"],
							"path": ["login"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"let response = pm.response.json();",
									"if (response.token) {",
									"   pm.environment.set(\"authToken\", response.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				}
			]
		},
		{
			"name": "user-types",
			"item": [
				{
					"name": "buscar todos os tipos",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{authToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/user-types/search",
							"host": ["{{baseUrl}}"],
							"path": ["user-types", "search"]
						}
					}
				},
				{
					"name": "criar tipo de usuário",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{authToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"CLIENTE\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/user-types",
							"host": ["{{baseUrl}}"],
							"path": ["user-types"]
						}
					}
				}
			]
		},
		{
			"name": "users",
			"item": [
				{
					"name": "criar usuário",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{authToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nome\": \"Joao Silva\",\n  \"email\": \"joao.silva@example.com\",\n  \"login\": \"joaosilva\",\n  \"senha\": \"senha123\",\n  \"endereco\": {\n    \"rua\": \"Rua X\",\n    \"bairro\": \"Bairro Y\",\n    \"cidade\": \"Cidade Z\",\n    \"estado\": \"SP\",\n    \"cep\": \"12345-678\"\n  },\n  \"papel\": \"ADMIN\",\n  \"tipo_usuario\": { \"name\": \"CLIENTE\" }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/users",
							"host": ["{{baseUrl}}"],
							"path": ["users"]
						}
					}
				},
				{
					"name": "consultar todos usuários",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{authToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/users",
							"host": ["{{baseUrl}}"],
							"path": ["users"]
						}
					}
				},
				{
					"name": "consultar usuário por id",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{authToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/users/1",
							"host": ["{{baseUrl}}"],
							"path": ["users", "1"]
						}
					}
				},
				{
					"name": "atualizar usuário",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{authToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nome\": \"Joao Silva Atualizado\",\n  \"email\": \"joao.novo@example.com\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/users/1",
							"host": ["{{baseUrl}}"],
							"path": ["users", "1"]
						}
					}
				},
				{
					"name": "trocar senha",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{authToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"senha_atual\": \"senha123\",\n  \"nova_senha\": \"senhaNova\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/users/1/change-password",
							"host": ["{{baseUrl}}"],
							"path": ["users", "1", "change-password"]
						}
					}
				},
				{
					"name": "deletar usuário",
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{authToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/users/1",
							"host": ["{{baseUrl}}"],
							"path": ["users", "1"]
						}
					}
				}
			]
		}
	],
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8080" },
		{ "key": "authToken", "value": "" }
	]
}
