# ----------------- TIPOS DE ENTIDADES ------------------

type User {
    id: ID!
    name: String!
    email: String!
    username: String!
    userRoleEnum: UserRoleEnum!
    userTypeNameEnum: UserTypeNameEnum!
}

type Restaurant {
    id: ID!
    name: String!
    address: String!
    cuisineType: String!
    openingHours: String!
}

type Order {
    id: ID!
    userId: ID!
    restaurantId: ID!
    delivery: Boolean!
    dateTimeOrder: String!
    valorTotal: Float!
    status: String!
}

# ----------------- QUERIES (LEITURA) ------------------

type Query {
    # Users
    userByUsername(username: String!): User
    allUsers: [User!]!

    # Restaurants
    restaurantById(id: ID!): Restaurant
    allRestaurants: [Restaurant!]!

    # Orders
    orderById(id: ID!): Order
    allOrders: [Order!]!
}

# ----------------- MUTATIONS (ESCRITA) ------------------

type Mutation {
    # Users
    createUser(name: String!, email: String!, username: String!, password: String!, userRoleEnum: UserRoleEnum!, userTypeNameEnum: UserTypeNameEnum!): User

    # Restaurants
    createRestaurant(
        name: String!,
        address: String!,
        cuisineType: String!,
        openingHours: String!
    ): Restaurant

    updateRestaurant(id: ID!, name: String, address: String, cuisineType: String, openingHours: String): Restaurant
    deleteRestaurant(id: ID!): Boolean

    # Orders
    createOrder(
        userId: ID!,
        restaurantId: ID!,
        delivery: Boolean!
    ): Order

    finalizeOrder(id: ID!): Order
}

enum UserTypeNameEnum {
    DONO_RESTAURANTE,
    CLIENTE
}

enum UserRoleEnum{
    DEFAULT,
    ADMIN
}