{
  "rabbit_version": "3.13",
  "vhosts": [
    { "name": "/bora" }
  ],
  "permissions": [
    { "user": "bora", "vhost": "/bora", "configure": ".*", "write": ".*", "read": ".*" }
  ],
  "queues": [
    { "name": "fila.teste", "vhost": "/bora", "durable": true, "auto_delete": false, "arguments": {} }
  ],
  "exchanges": [
    { "name": "ex.bora", "vhost": "/bora", "type": "direct", "durable": true, "auto_delete": false, "internal": false, "arguments": {} }
  ],
  "bindings": [
    { "source": "ex.bora", "vhost": "/bora", "destination": "fila.teste", "destination_type": "queue", "routing_key": "rk.teste", "arguments": {} }
  ]
}
